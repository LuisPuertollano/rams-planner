{
  "name": "rams-planner",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "check:deps": "node tools/check-dependency-rule.mjs",
    "check:hallazgos": "node tools/check-finding-translations.mjs",
    "check:permisos": "node tools/check-permission-translations.mjs",
    "db:up": "dbmate --migrations-dir ./db/migrations up",
    "db:status": "dbmate --migrations-dir ./db/migrations status",
    "verify": "pnpm lint && pnpm typecheck && pnpm check:deps && pnpm check:hallazgos && pnpm check:permisos && pnpm test:coverage",
    "dev:api": "node --env-file=.env packages/api/dist/server.js",
    "dev:web": "pnpm --filter @planner/web dev",
    "db:demo": "node --env-file=.env packages/api/dist/cli.js seed-demo",
    "db:calculate": "node --env-file=.env packages/api/dist/cli.js calculate"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "fast-check": "^3.23.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "vitest": "^2.1.8"
  }
}
