# Copia a .env y ajusta. El puerto 45432 evita chocar con un Postgres local.
POSTGRES_USER=planner
POSTGRES_PASSWORD=planner_dev_only
POSTGRES_DB=planner
POSTGRES_PORT=45432

# dbmate: sslmode=disable sólo para desarrollo local
DATABASE_URL=postgres://planner:planner_dev_only@localhost:45432/planner?sslmode=disable
