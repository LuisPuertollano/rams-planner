# Copia a .env y ajusta. Los puertos 454xx evitan chocar con servicios locales.
POSTGRES_USER=planner
POSTGRES_PASSWORD=planner_dev_only
POSTGRES_DB=planner
POSTGRES_PORT=45432

# Puerto en el que la aplicación queda disponible (API + interfaz).
API_PORT=45678

# Carga el juego de datos de demostración la primera vez. "false" para empezar
# con la base vacía.
SEED_DEMO=true

# Para las herramientas que se ejecutan fuera de Docker (dbmate, la CLI, los
# tests de integración). sslmode=disable sólo para desarrollo local.
DATABASE_URL=postgres://planner:planner_dev_only@localhost:45432/planner?sslmode=disable
